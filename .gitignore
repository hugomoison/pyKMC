# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/

# Tests — whitelist everything, then re-ignore generated files
*test*
!tests/
!tests/**/*
tests/**/__pycache__/
tests/**/*.py[cod]

# Benchmarks — keep only scripts
benchmarks/**
!benchmarks/*/
!benchmarks/**/*.py
!benchmarks/**/*.sh

# Utils
utils/analyse/*.xyz

# LAMMPS / simulation outputs
*core
!**/_core/
!**/_core/**
**/_core/__pycache__/
**/_core/**/*.py[cod]
log.lammps
pykmc.*

# IDE
.vscode/**
.idea/**
.claude/**

# OS
.DS_Store

# Examples — ignore everything except inputs, potentials and expected_outputs/
# (kept last so it overrides global patterns such as pykmc.*)
examples/**
!examples/**/
!examples/README.md
!examples/*/input.in.template
!examples/*/initial_config.xyz
!examples/*/*.eam
!examples/*/*.eam.alloy
!examples/*/*.eam.fs
!examples/*/*.sw
!examples/*/*.tersoff
!examples/*/*.almtp
!examples/*/expected_outputs/**
