[Control] 
initial_config = ./initial_config.xyz
n_steps = 100
engine = lammps
verbosity = 1
n_sessions = 7

[Lammps] 
pair_style = eam/alloy 
pair_coeff = * * ./Cu01.eam.alloy Cu
min_style = cg 
minimize = 1e-10 1e-12 10000 10000

[AtomicEnvironment] 
style = cna/graph
rnei = 2.9
rcut = 6.5

[EventSearch] 
style = partn
nsearch = 10

[pARTn] 

[RateConstant] 
style = constant
k0 = 10.0
T = 300.0

[PSR] 
style = ira 
matching_score_thr = 0.4

[IRA]
kmax_factor = 2.0
