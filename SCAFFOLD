class Executor:
    def __init__(self, map_fn: Callable | None = None) -> None:
        self._map = map_fn

    def run(self, func: Callable, items: list, **shared_kwargs) -> list:
        if self._map is None:
            return [func(item, **shared_kwargs) for item in items]
        futures = self._map(func, items=items, **shared_kwargs)
        return [f.result() for f in futures]

    @classmethod
    def serial(cls) -> Executor:
        return cls(map_fn=None)

    @classmethod
    def parallel(cls, map_fn: Callable) -> Executor:
        return cls(map_fn=map_fn)


