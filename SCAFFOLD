from __future__ import annotations
from dataclasses import dataclass
from concurrent.futures import Future
from typing import Callable
import threading
import queue


@dataclass
class Job:
    op_name: str
    kwargs:  dict
    future:  Future


class Worker:
    """
    Générique pur — aucune dépendance vers Engine ou tout autre module.
    Connaît uniquement : un registre de callables et une queue de jobs.
    """
    def __init__(self, registry: dict[str, Callable], job_queue: queue.Queue) -> None:
        self.registry  = registry
        self.job_queue = job_queue
        self._thread   = threading.Thread(target=self._loop, daemon=True)

    def start(self) -> None:
        self._thread.start()

    def _loop(self) -> None:
        while True:
            job: Job = self.job_queue.get()
            if job is None:   # poison pill
                break
            try:
                func   = self.registry[job.op_name]
                result = func(**job.kwargs)
                job.future.set_result(result)
            except Exception as e:
                job.future.set_exception(e)
            finally:
                self.job_queue.task_done()


