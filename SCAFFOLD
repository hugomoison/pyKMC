class State:
    """
    Agrège System, NeighborsList et AtomicEnvironmentResult.
    Lazy recalcul : invalide neighbors/environment quand positions changent.
    """
    def __init__(self, system, neighbors_method, environment_method, engine) -> None:
        self.system             = system
        self._neighbors_method  = neighbors_method
        self._environment_method= environment_method
        self._engine            = engine
        self._neighbors         = None
        self._environment       = None

    def update_positions(self, new_positions) -> None:
        self.system.update_positions(new_positions)
        self._neighbors  = None   # invalide
        self._environment= None   # invalide

    @property
    def neighbors(self) -> NeighborsList:
        if self._neighbors is None:
            self._neighbors = self._neighbors_method.build(
                self._engine, self.system, config=None  # TODO: passer config
            )
        return self._neighbors

    @property
    def environment(self) -> AtomicEnvironmentResult:
        if self._environment is None:
            self._environment = self._environment_method.compute(
                self._engine, self.neighbors, self.system
            )
        return self._environment


class StateFactory:
    @staticmethod
    def build(system, neighbors_method, environment_method, engine) -> State:
        return State(system, neighbors_method, environment_method, engine)


