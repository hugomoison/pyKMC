class Manager:
    """
    Générique pur — aucune dépendance vers Engine.
    Orchestre des Workers via leurs registres de callables.
    """
    def __init__(
        self,
        local_registries:  list[dict[str, Callable]],
        global_registry:   dict[str, Callable] | None = None,
    ) -> None:
        self._local_queue:  queue.Queue[Job] = queue.Queue()
        self._global_queue: queue.Queue[Job] = queue.Queue()

        self._local_workers = [
            Worker(registry, self._local_queue)
            for registry in local_registries
        ]
        self._global_worker = Worker(
            global_registry or {}, self._global_queue
        )

    # --- Lifecycle ---
    def start(self) -> None:
        for w in self._local_workers:  w.start()
        self._global_worker.start()

    def close(self) -> None:
        for _ in self._local_workers:  self._local_queue.put(None)
        self._global_queue.put(None)

    # --- Submit API ---
    def submit(self, op_name: str, **kwargs) -> Future:
        """Soumet un job au pool local (premier worker disponible)."""
        future = Future()
        self._local_queue.put(Job(op_name, kwargs, future))
        return future

    def submit_global(self, op_name: str, **kwargs) -> Future:
        """Soumet un job au worker global."""
        future = Future()
        self._global_queue.put(Job(op_name, kwargs, future))
        return future

    def map(self, op_name: str, items: list, **shared_kwargs) -> list[Future]:
        """Distribue op_name sur items à travers les workers locaux."""
        futures = []
        for item in items:
            future = Future()
            self._local_queue.put(Job(op_name, {"item": item, **shared_kwargs}, future))
            futures.append(future)
        return futures


