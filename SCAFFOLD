import inspect
from typing import Callable


def registrable(name: str | None = None):
    """
    Marque une méthode comme exposable dans le registre du Manager.
    No-op si manager/ n'est pas installé — voir try/except dans engine/base.py.
    """
    def decorator(func):
        func._registry_name = name or func.__name__
        return func
    return decorator


def build_registry(obj, engine=None) -> dict[str, Callable]:
    """
    Construit un registry à partir des méthodes marquées @registrable.
    Si engine est fourni, il est injecté comme premier argument.
    """
    registry = {}
    for _, method in inspect.getmembers(obj, predicate=inspect.ismethod):
        if hasattr(method, "_registry_name"):
            reg_name = method._registry_name
            if engine is not None:
                registry[reg_name] = lambda **kw, m=method: m(engine, **kw)
            else:
                registry[reg_name] = lambda **kw, m=method: m(**kw)
    return registry


