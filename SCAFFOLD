# ==============================================================
# environment/cna_graph/python.py
# ==============================================================

class CnaGraphMethod(EnvironmentMethod):  # E déterminé par cna_method
    def __init__(
        self,
        cna_method:   EnvironmentMethod,
        graph_method: PythonGraphMethod,
        neighbors_add: int = 0,
    ) -> None:
        self.cna_method    = cna_method
        self.graph_method  = graph_method
        self.neighbors_add = neighbors_add

    def compute(self, engine, neighbors: NeighborsList, system) -> AtomicEnvironmentResult:
        # Étape 1 — CNA
        cna_result   = self.cna_method.compute(engine, neighbors, system)
        non_crystal  = [i for i, e in enumerate(cna_result.ids) if e == "noncrystal"]

        # Étape 2 — shells supplémentaires
        if self.neighbors_add > 0:
            extra = set()
            current = non_crystal
            for _ in range(self.neighbors_add):
                current = [n for i in current for n in neighbors.neighbors[i]]
                extra.update(current)
            non_crystal = list(set(non_crystal) | extra)

        # Étape 3 — Graph sur non-cristallins
        graph_result = self.graph_method.compute(None, neighbors, system, atoms=non_crystal)

        # Étape 4 — merge
        merged = list(cna_result.ids)
        for i, atom_idx in enumerate(non_crystal):
            merged[atom_idx] = graph_result.ids[i]

        return AtomicEnvironmentResult(ids=merged, style="cna/graph")


